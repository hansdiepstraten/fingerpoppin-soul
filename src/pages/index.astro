---
import Base from '../layouts/Base.astro';
import MixcloudEmbed from '../components/MixcloudEmbed.astro';
import { hideaway } from '../data/hideaway';
import { Image } from 'astro:assets';
import recordFoto from '../assets/finger-poppin-time-45-round.png';
import canalFoto from '../assets/amsterdam-canal.jpg';
---
<Base>
  <!-- HERO: the record is the thesis -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Soul radio · Amsterdam · since 1993</p>
        <h1>The best in soul, delivered from Amsterdam.</h1>
        <p class="lede">
          Hans Diepstraten &amp; Harry van Vliet have spun sweet soul, ballads and
          rare grooves on Amsterdam's airwaves every Thursday for over thirty
          years.
        </p>
        <div class="cta-row">
          <a href="/listen" class="btn">Listen to the show</a>
          <a href="/blog" class="btn-ghost btn">Latest from the show</a>
        </div>
      </div>
      <div class="hero-record">
        <Image src={recordFoto} alt="Finger Poppin' Time — Hank Ballard 45, People Records, with Hans &amp; Harry pictured on the center label" class="record-photo" widths={[400, 700, 1000]} sizes="(min-width: 860px) 560px, 80vw" />
      </div>
    </div>
  </section>

  <!-- Full-bleed banner: Amsterdam, where the show comes from -->
  <section class="canal-banner">
    <Image
      src={canalFoto}
      alt="Canal houses along an Amsterdam gracht"
      class="canal-banner-img"
      widths={[640, 1024, 1600]}
      sizes="100vw"
    />
  </section>

  <!-- Latest on the air -->
  <section class="rule-top">
    <div class="wrap">
      <p class="eyebrow">On the air</p>
      <h2>Latest shows</h2>
      <p class="lede">Every week's show, streamed and archived on Mixcloud.</p>
      <div class="mix"><MixcloudEmbed /></div>
    </div>
  </section>

  <!-- The Hideaway: a side project, kept low-key on the homepage -->
  <section class="rule-top">
    <div class="wrap hideaway-mention">
      <p class="eyebrow">Also from Hans &amp; Harry · roughly every two months</p>
      <p class="lede">
        <strong>The Hideaway</strong> — a vinyl-only soul night at
        {hideaway.venue.building}. <a href="/the-hideaway">Season {hideaway.season} dates &amp; guests →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: 1.2cm;
    padding-bottom: 1.2cm;
  }
  .hero-grid {
    display: grid;
    gap: clamp(0.5rem, 2vw, 1.25rem);
    align-items: center;
    grid-template-columns: 1fr;
  }
  .hero-record { display: flex; justify-content: center; order: -1; }
  @media (min-width: 860px) {
    .hero-grid { grid-template-columns: 1fr min(570px, 72vh); }
    .hero-record { order: 0; }
  }
  .hero-copy h1 { font-size: clamp(1.7rem, 1.2rem + 2.2vw, 2.9rem); margin-bottom: 0.3em; }
  .hero-copy .eyebrow { margin-bottom: 0.5rem; }
  .hero-copy .lede { margin: 0.5em 0 0; }
  .record-photo {
    display: block;
    width: 100%;
    height: auto;
    max-width: min(570px, 72vh);
    aspect-ratio: 1 / 1;
    object-fit: contain;
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1rem; }
  .canal-banner { padding-block: 0; line-height: 0; }
  .canal-banner-img {
    display: block;
    width: 100%;
    height: clamp(180px, 26vw, 340px);
    object-fit: cover;
    object-position: center 58%;
  }
  .mix { max-width: 640px; margin-top: 1.5rem; }
  .hideaway-mention { max-width: 640px; }
</style>
