<style>
  .prose { max-width: 760px; }
  .artist-row { color: var(--cream-dim); }
  .photo-grid {
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 640px) { .photo-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 960px) { .photo-grid { grid-template-columns: repeat(4, 1fr); } }
  .photo-grid figure { margin: 0; }
  .photo-grid img { width: 100%; height: auto; border-radius: 3px; display: block; }
  .photo-grid figcaption { font-size: 0.82rem; color: var(--cream-dim); margin-top: 0.4rem; }
</style>
