---
import { hideaway } from '../data/hideaway';
const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', {
    weekday: 'short', day: 'numeric', month: 'short', year: 'numeric',
  });
const today = new Date().toISOString().slice(0, 10);
const upcoming = hideaway.dates.filter((d) => d.date >= today);
const list = upcoming.length ? upcoming : hideaway.dates;
---
<ul class="dates">
  {list.map((d) => (
    <li>
      <span class="date">{fmt(d.date)}</span>
      {d.guest
        ? <span class="guest">Guest: {d.guest}</span>
        : <span class="guest muted">Guest DJ TBA</span>}
    </li>
  ))}
</ul>

<style>
  .dates { list-style: none; margin: 0; padding: 0; }
  .dates li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .date { font-family: var(--font-display); font-size: 1.15rem; color: var(--cream); }
  .guest { font-size: 0.9rem; color: var(--gold); }
  .guest.muted { color: var(--cream-dim); }
</style>
